#!/bin/bash
# Rejects binary executables, WIP commits, multiple-commit pushes, and lints on main pushes.

set -euo pipefail

if (($# != 2)); then
	printf '%s\n' 'Usage: pre-push <remote-name> <remote-url>' >&2
	exit 2
fi

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

while read -r local_ref local_oid remote_ref remote_oid; do
	if [ "$local_oid" = "$zero" ]; then
		continue
	fi
	if [ "$remote_oid" = "$zero" ]; then
		range="$local_oid"
	else
		range="$remote_oid..$local_oid"
	fi
	binaries=$(git diff-tree -r --name-only --diff-filter=ACM "$range" | while read -r file; do
		git cat-file -e "$local_oid:$file" 2>/dev/null && git show "$local_oid:$file" | file --mime-type - 2>/dev/null | grep -qE 'application/(x-executable|x-mach-binary|x-dosexec|x-pie-executable|x-sharedlib)' && echo "$file"
	done || true)
	if [ -n "$binaries" ]; then
		echo >&2 '✗ Binary executables cannot be pushed:'
		echo >&2 "$binaries"
		exit 1
	fi
	commit=$(git rev-list -n 1 --grep '^WIP' "$range")
	if [ -n "$commit" ]; then
		echo >&2 "Found WIP commit in $local_ref, not pushing"
		exit 1
	fi
	if [ "$remote" = origin ] && [ "$remote_ref" = refs/heads/main ]; then
		golangci-lint run ./...

		commit_count=$(git rev-list --count "$range" 2>/dev/null || true)
		if [ -n "$commit_count" ] && [ "$commit_count" -gt 1 ]; then
			echo >&2 "✗ Push blocked: $commit_count commits on $local_ref (limit is 1 per push)."
			echo >&2 "  Squash with: git reset --soft HEAD~$commit_count && git commit"
			exit 1
		fi
	fi
done
