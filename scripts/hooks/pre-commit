#!/bin/bash
# Runs focused checks against the staged snapshot.

set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir
repo_root="$(CDPATH='' cd -- "$script_dir/../.." && pwd)"
readonly repo_root

cd -- "$repo_root"
./scripts/check-staged.sh
