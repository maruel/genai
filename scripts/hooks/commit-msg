#!/bin/bash
# Rejects incomplete, overlong, or co-authored commit messages.

set -euo pipefail

print_commit_guidance() {
	printf '%s\n' \
		'Commit guidance for coding agents:' \
		'  - Use a concise subject.' \
		'  - After a blank line, explain the rationale and consequential tradeoffs.' \
		'  - Scale detail with the change; do not merely restate the diff.' >&2
}

if (($# != 1)); then
	printf '%s\n' 'Usage: commit-msg <message-file>' >&2
	print_commit_guidance
	exit 2
fi

message_file=$1
readonly message_file

if [[ ! -f "$message_file" ]]; then
	printf 'Commit message file does not exist: %s\n' "$message_file" >&2
	print_commit_guidance
	exit 2
fi

if grep -Fq '\n' "$message_file"; then
	printf '%s\n' 'Commit messages must use actual line breaks, not literal \n sequences.' >&2
	print_commit_guidance
	exit 1
fi

if grep -Eiq '^co-authored-by: ' "$message_file"; then
	printf '%s\n' 'Commit messages must not contain Co-authored-by trailers.' >&2
	print_commit_guidance
	exit 1
fi

if ! awk '
  /^[[:space:]]*#/ { next }
  !subject {
    if (NF) subject = 1
    next
  }
  !separator {
    if (!NF) {
      separator = 1
      next
    }
    invalid_separator = 1
    next
  }
  NF { body = 1 }
  END { exit !(subject && separator && body) || invalid_separator }
' "$message_file"; then
	printf '%s\n' 'Commit messages need a subject, blank line, and rationale body.' >&2
	print_commit_guidance
	exit 1
fi

if ! awk '
  /^[[:space:]]*#/ { next }
  !subject {
    if (NF) subject = 1
    next
  }
  !separator {
    if (!NF) separator = 1
    next
  }
  NF && length($0) > 120 {
    printf "Commit body line %d is %d characters; maximum is 120.\n", NR, length($0) > "/dev/stderr"
    exit 1
  }
' "$message_file"; then
	print_commit_guidance
	exit 1
fi
